{
  "//": "The CLI's own type check, run by src/__tests__/boundary.test.ts: Node.js only (no DOM), and only syntax Node.js can strip, so `node src/mgm.ts` runs the sources as they are.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
