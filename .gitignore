# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# GUI stylesheets and their manifest (scripts/gui/build-stylesheets.mjs)
/public/gui-styles/
/src/gui/.generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (explicit: templates like .env.pilot.example stay committable)
.env
.env.local
.env*.local
.env.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI
supabase/.temp/
.supabase/
supabase/.branches/

# Generated seed migration — contains bcrypt password hashes injected at setup time
# (template is committed as supabase/migrations/00003_seed.sql.template).
supabase/migrations/00003_seed.sql

# Browser smoke (playwright.config.ts). e2e/.auth/ holds session cookies.
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
