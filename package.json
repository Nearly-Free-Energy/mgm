{
  "name": "mgm",
  "version": "0.1.0",
  "private": true,
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nearly-Free-Energy/mgm.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/gui/build-stylesheets.mjs --dev && next dev",
    "build": "node scripts/gui/build-stylesheets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mgm": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON packages/mgm-cli/src/mgm.ts",
    "gui:styles:watch": "node scripts/gui/build-stylesheets.mjs --dev --watch",
    "db:types": "sh scripts/db-types.sh write",
    "db:types:linked": "sh scripts/db-types.sh print",
    "db:types:check": "sh scripts/db-types.sh check",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "aws4": "^1.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cordis": "4.0.0-rc.12",
    "lucide-react": "1.62.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "^4.2.1",
    "@tailwindcss/oxide": "^4.2.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jose": "^6.2.2",
    "jsdom": "^29.0.2",
    "pdf-parse": "^2.4.5",
    "prettier": "3.9.10",
    "supabase": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
